# ============================================================
# BimaVani (बीमा-वाणी) environment configuration
# Copy to .env and fill in your live key from https://app.gnani.ai/voice
# (docs: https://docs.gnani.ai) — 5,000 programme credits included.
# ============================================================

# --- Gnani.ai Vachana / Artha ecosystem (REQUIRED for live mode) ---
GNANI_API_KEY=
# Without a key BimaVani still runs 100% in Credit-Shield Fallback Mode.

# --- Gnani Prisma STT (Speech-to-Text) ---
GNANI_STT_MODEL=prisma-v3.0
# supported values: prisma-v3.0, prisma-v2.5
GNANI_STT_LANGUAGE=indic-auto
# indic-auto | hi-IN | en-IN | mr-IN | ta-IN | te-IN | kn-IN | ml-IN | bn-IN | gu-IN | pa-IN
GNANI_STT_FORMAT=codemix
# codemix | transcribe (automatically forced to transcribe when indic-auto is selected)

# --- Gnani Timbre TTS (Text-to-Speech) ---
# NEVER use timbre-v2.0 (RETIRED). Use v3.0 or v2.5 only.
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=hi-IN

# --- Optional OpenAI-compatible Brain LLM (deterministic by default) ---
# Only set if you want an LLM assist; BimaVani is fully deterministic with 0 LLM.
# Accepts gnani/gnani-evon-v3.3-30B-A3B, groq/llama-*, gemini/*, openai/*
BIMAVANI_LLM_MODEL=gnani/gnani-evon-v3.3-30B-A3B
LLM_API_KEY=
LLM_BASE_URL=

# --- Networking ---
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# --- Gnani base URL (do not change unless instructed) ---
GNANI_BASE_URL=https://api.vachana.ai
